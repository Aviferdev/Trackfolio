-- Migración v9: Nuevo sistema de tipos de ingreso con entidades emisoras.
-- DESTRUCTIVA: elimina todas las transacciones y categorías de ingreso existentes.

-- ── 1. Recrear TransactionEntity con nuevos campos ────────────────────────────

DROP INDEX IF EXISTS idx_transaction_account;
DROP INDEX IF EXISTS idx_transaction_date;
DROP TABLE IF EXISTS TransactionEntity;

CREATE TABLE TransactionEntity (
    id                    TEXT    NOT NULL PRIMARY KEY,
    accountId             TEXT    NOT NULL,
    amount                REAL    NOT NULL,
    type                  TEXT    NOT NULL,
    categoryId            TEXT,
    date                  INTEGER NOT NULL,
    notes                 TEXT,
    createdAt             INTEGER NOT NULL,
    incomeType            TEXT,
    grossAmount           REAL,
    irpfPercent           REAL,
    socialSecurityAmount  REAL,
    commissionAmount      REAL,
    issuerId              TEXT,
    issuerName            TEXT,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id)
);

CREATE INDEX idx_transaction_account ON TransactionEntity(accountId);
CREATE INDEX idx_transaction_date    ON TransactionEntity(date);

-- ── 2. Eliminar categorías de ingreso ─────────────────────────────────────────

DELETE FROM CategoryEntity WHERE type = 'INCOME';

-- ── 3. Crear tablas de entidades emisoras ─────────────────────────────────────

CREATE TABLE EmployerEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🏢',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);
CREATE INDEX idx_employer_account  ON EmployerEntity(accountId);
CREATE INDEX idx_employer_archived ON EmployerEntity(archived);

CREATE TABLE BankEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🏦',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);
CREATE INDEX idx_bank_account  ON BankEntity(accountId);
CREATE INDEX idx_bank_archived ON BankEntity(archived);

CREATE TABLE BondIssuerEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '📜',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);
CREATE INDEX idx_bond_issuer_account  ON BondIssuerEntity(accountId);
CREATE INDEX idx_bond_issuer_archived ON BondIssuerEntity(archived);

CREATE TABLE DividendSourceEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '📈',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);
CREATE INDEX idx_dividend_source_account  ON DividendSourceEntity(accountId);
CREATE INDEX idx_dividend_source_archived ON DividendSourceEntity(archived);

CREATE TABLE PromotionPlatformEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🎁',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);
CREATE INDEX idx_promo_platform_account  ON PromotionPlatformEntity(accountId);
CREATE INDEX idx_promo_platform_archived ON PromotionPlatformEntity(archived);
