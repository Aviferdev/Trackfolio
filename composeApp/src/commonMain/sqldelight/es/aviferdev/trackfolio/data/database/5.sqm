-- Migración v4 → v5
-- Portfolio: añade categorías de activos (Cryptos, ETFs, Bonos…) y un sistema
-- de etiquetas multi-valor con peso para atributos como sectores, regiones, etc.

-- ── Categorías de activos (separadas de las de gastos/ingresos) ──────────────
CREATE TABLE AssetCategoryEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '📦',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_asset_category_archived ON AssetCategoryEntity(archived);

-- ── Etiquetas libres (Tecnología, Salud, USA, Europa…) ───────────────────────
-- categoryId opcional: una etiqueta puede aplicar solo a una categoría (ej.
-- "Sector farmacéutico" solo aplica a ETFs/Acciones) o ser global (categoryId NULL).
CREATE TABLE AssetTagEntity (
    id          TEXT    NOT NULL PRIMARY KEY,
    name        TEXT    NOT NULL,
    categoryId  TEXT,
    color       TEXT    NOT NULL DEFAULT '#3D6EAD',
    archived    INTEGER NOT NULL DEFAULT 0,
    createdAt   INTEGER NOT NULL,
    FOREIGN KEY (categoryId) REFERENCES AssetCategoryEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_asset_tag_category ON AssetTagEntity(categoryId);
CREATE INDEX idx_asset_tag_archived ON AssetTagEntity(archived);

-- ── Asignación N:M asset ↔ tag con peso porcentual ───────────────────────────
-- weight en 0..100 (el cliente valida que la suma por asset sea ≤ 100).
CREATE TABLE AssetTagAssignmentEntity (
    assetId  TEXT NOT NULL,
    tagId    TEXT NOT NULL,
    weight   REAL NOT NULL DEFAULT 0.0,
    PRIMARY KEY (assetId, tagId),
    FOREIGN KEY (assetId) REFERENCES AssetEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId)   REFERENCES AssetTagEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_asset_tag_assignment_asset ON AssetTagAssignmentEntity(assetId);
CREATE INDEX idx_asset_tag_assignment_tag   ON AssetTagAssignmentEntity(tagId);

-- ── Añadir assetCategoryId a AssetEntity ─────────────────────────────────────
ALTER TABLE AssetEntity ADD COLUMN assetCategoryId TEXT;

CREATE INDEX idx_asset_category ON AssetEntity(assetCategoryId);
