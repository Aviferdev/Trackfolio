CREATE TABLE BondIssuerEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '📜',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_bond_issuer_account  ON BondIssuerEntity(accountId);
CREATE INDEX idx_bond_issuer_archived ON BondIssuerEntity(archived);

selectByAccount:
SELECT * FROM BondIssuerEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY name ASC;

selectAllByAccount:
SELECT * FROM BondIssuerEntity
WHERE accountId = :accountId
ORDER BY archived ASC, name ASC;

selectById:
SELECT * FROM BondIssuerEntity WHERE id = :id;

insert:
INSERT OR IGNORE INTO BondIssuerEntity(id, accountId, name, icon, archived, createdAt)
VALUES (?, ?, ?, ?, 0, ?);

updateName:
UPDATE BondIssuerEntity SET name = :name, icon = :icon WHERE id = :id;

archive:
UPDATE BondIssuerEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE BondIssuerEntity SET archived = 0 WHERE id = :id;
