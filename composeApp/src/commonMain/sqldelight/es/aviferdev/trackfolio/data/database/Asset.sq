-- AssetEntity: catálogo del activo. Los datos de cantidad/precio/fecha de
-- cada compra o venta viven en AssetTransactionEntity. `currentPrice` y
-- `currentPriceUpdatedAt` representan la cotización actual del activo,
-- editable desde la UI; cuando son NULL la app interpreta P&L = 0
-- ("Sin precio actual").

CREATE TABLE AssetEntity (
    id                     TEXT    NOT NULL PRIMARY KEY,
    accountId              TEXT    NOT NULL,
    ticker                 TEXT    NOT NULL,
    name                   TEXT    NOT NULL,
    notes                  TEXT,
    createdAt              INTEGER NOT NULL,
    assetCategoryId        TEXT,
    currentPrice           REAL,
    currentPriceUpdatedAt  INTEGER,
    FOREIGN KEY (accountId)       REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (assetCategoryId) REFERENCES AssetCategoryEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_asset_account  ON AssetEntity(accountId);
CREATE INDEX idx_asset_category ON AssetEntity(assetCategoryId);

selectAll:
SELECT * FROM AssetEntity ORDER BY createdAt DESC;

selectByAccount:
SELECT * FROM AssetEntity
WHERE accountId = :accountId
ORDER BY createdAt DESC;

selectByAccountAndCategory:
SELECT * FROM AssetEntity
WHERE accountId = :accountId AND assetCategoryId = :categoryId
ORDER BY createdAt DESC;

selectById:
SELECT * FROM AssetEntity WHERE id = :id;

insert:
INSERT INTO AssetEntity(id, accountId, ticker, name, notes, createdAt, assetCategoryId, currentPrice, currentPriceUpdatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE AssetEntity
SET ticker = :ticker, name = :name, notes = :notes,
    assetCategoryId = :assetCategoryId,
    currentPrice = :currentPrice, currentPriceUpdatedAt = :currentPriceUpdatedAt
WHERE id = :id;

-- Refresca solo el precio actual y la fecha (atajo desde la UI sin abrir el
-- formulario completo de edición del activo).
updateCurrentPrice:
UPDATE AssetEntity
SET currentPrice = :currentPrice, currentPriceUpdatedAt = :currentPriceUpdatedAt
WHERE id = :id;

delete:
DELETE FROM AssetEntity WHERE id = :id;

-- Activos con posiciones abiertas cuyo precio no se ha actualizado
-- desde :thresholdDate (epoch millis). "Posición abierta" = SUM(BUY) - SUM(SELL) > 0.
selectOutdatedByAccount:
SELECT a.* FROM AssetEntity a
WHERE a.accountId = :accountId
  AND (
    SELECT COALESCE(
      SUM(CASE WHEN t.type = 'BUY' THEN t.quantity ELSE 0 END) -
      SUM(CASE WHEN t.type = 'SELL' THEN t.quantity ELSE 0 END),
      0
    )
    FROM AssetTransactionEntity t WHERE t.assetId = a.id
  ) > 0
  AND (a.currentPriceUpdatedAt IS NULL OR a.currentPriceUpdatedAt < :thresholdDate)
ORDER BY a.name ASC;
