CREATE TABLE EmployerEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🏢',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_employer_account  ON EmployerEntity(accountId);
CREATE INDEX idx_employer_archived ON EmployerEntity(archived);

selectByAccount:
SELECT * FROM EmployerEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY name ASC;

selectAllByAccount:
SELECT * FROM EmployerEntity
WHERE accountId = :accountId
ORDER BY archived ASC, name ASC;

selectById:
SELECT * FROM EmployerEntity WHERE id = :id;

insert:
INSERT OR IGNORE INTO EmployerEntity(id, accountId, name, icon, archived, createdAt)
VALUES (?, ?, ?, ?, 0, ?);

updateName:
UPDATE EmployerEntity SET name = :name, icon = :icon WHERE id = :id;

archive:
UPDATE EmployerEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE EmployerEntity SET archived = 0 WHERE id = :id;
