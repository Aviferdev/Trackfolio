-- Migración v6 → v7
-- Refactor profundo del dominio "Portfolio":
--
-- 1. Se crea la entidad `PlatformEntity` (broker/exchange) gestionada desde
--    Ajustes igual que las categorías: CRUD con archivado lógico.
--
-- 2. Se crea la entidad `AssetTransactionEntity` que representa cada compra
--    o venta (BUY/SELL) de un activo, con su fecha, precio unitario, cantidad
--    y la plataforma donde se ejecutó. Reemplaza al concepto de "posición"
--    embebida que tenía `AssetEntity`.
--
-- 3. Se reescribe `AssetEntity`: deja de almacenar quantity/purchasePrice/
--    purchaseDate (esos datos viven ahora en AssetTransactionEntity).
--    `currentPrice` y `currentPriceUpdatedAt` siguen aquí — el precio actual
--    pertenece al activo, no al movimiento.
--
-- Datos previos: por la decisión 2.B en el rediseño, se eliminan los activos
-- que pudieran existir antes (DROP TABLE limpia AssetEntity y, vía FK CASCADE,
-- también AssetTagAssignmentEntity). El usuario empieza el catálogo de cero.

-- ── 1. Plataformas ──────────────────────────────────────────────────────────
CREATE TABLE PlatformEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🏦',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_platform_archived ON PlatformEntity(archived);

-- ── 2. Reescritura de AssetEntity (drop + create) ───────────────────────────
DROP TABLE AssetEntity;

CREATE TABLE AssetEntity (
    id                     TEXT    NOT NULL PRIMARY KEY,
    accountId              TEXT    NOT NULL,
    ticker                 TEXT    NOT NULL,
    name                   TEXT    NOT NULL,
    notes                  TEXT,
    createdAt              INTEGER NOT NULL,
    assetCategoryId        TEXT,
    currentPrice           REAL,
    currentPriceUpdatedAt  INTEGER,
    FOREIGN KEY (accountId)       REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (assetCategoryId) REFERENCES AssetCategoryEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_asset_account  ON AssetEntity(accountId);
CREATE INDEX idx_asset_category ON AssetEntity(assetCategoryId);

-- ── 3. Movimientos (compra/venta) de activos ────────────────────────────────
-- type: "BUY" o "SELL". Se valida desde el dominio, no por CHECK constraint
--       (SQLite 3.18 no soporta CHECK con texto fiable cross-platform).
-- feeNote: texto libre informativo sobre la comisión. NO entra en cálculos.
-- platformId: obligatorio. ON DELETE RESTRICT para que no se pueda eliminar
--             una plataforma físicamente si tiene movimientos asociados (el
--             flujo del usuario archiva la plataforma, no la borra).
CREATE TABLE AssetTransactionEntity (
    id            TEXT    NOT NULL PRIMARY KEY,
    assetId       TEXT    NOT NULL,
    type          TEXT    NOT NULL,
    quantity      REAL    NOT NULL,
    pricePerUnit  REAL    NOT NULL,
    date          INTEGER NOT NULL,
    platformId    TEXT    NOT NULL,
    feeNote       TEXT,
    notes         TEXT,
    createdAt     INTEGER NOT NULL,
    FOREIGN KEY (assetId)    REFERENCES AssetEntity(id)    ON DELETE CASCADE,
    FOREIGN KEY (platformId) REFERENCES PlatformEntity(id) ON DELETE RESTRICT
);

CREATE INDEX idx_asset_tx_asset    ON AssetTransactionEntity(assetId);
CREATE INDEX idx_asset_tx_platform ON AssetTransactionEntity(platformId);
CREATE INDEX idx_asset_tx_date     ON AssetTransactionEntity(date);
