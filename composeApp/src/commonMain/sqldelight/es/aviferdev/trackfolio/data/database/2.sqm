CREATE TABLE AccountEntity_new (
    id        TEXT    NOT NULL PRIMARY KEY,
    name      TEXT    NOT NULL,
    currency  TEXT    NOT NULL DEFAULT 'EUR',
    balance   REAL    NOT NULL DEFAULT 0.0,
    createdAt INTEGER NOT NULL
);

INSERT INTO AccountEntity_new (id, name, currency, balance, createdAt)
SELECT id, name, currency, balance, createdAt FROM AccountEntity;

DROP TABLE AccountEntity;

ALTER TABLE AccountEntity_new RENAME TO AccountEntity;

ALTER TABLE DebtEntity ADD COLUMN accountId TEXT NOT NULL DEFAULT 'account_default';

CREATE INDEX IF NOT EXISTS idx_debt_account ON DebtEntity(accountId);
