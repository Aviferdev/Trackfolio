-- Migración v7 → v8
-- Añade campos de información fiscal (IRPF) a TransactionEntity.
--
-- Los tres campos son OPCIONALES (nullable) y solo aplican a ingresos
-- (type = 'INCOME'). Los movimientos existentes los tendrán a NULL, lo
-- que equivale a "sin información fiscal introducida".
--
--  · grossAmount  — importe bruto antes de la retención
--  · irpfPercent  — porcentaje de retención aplicado (ej. 19.0)
--  · taxType      — tipo de rendimiento IRPF (nombre del enum IncomeTaxType)

ALTER TABLE TransactionEntity ADD COLUMN grossAmount REAL;
ALTER TABLE TransactionEntity ADD COLUMN irpfPercent REAL;
ALTER TABLE TransactionEntity ADD COLUMN taxType     TEXT;
