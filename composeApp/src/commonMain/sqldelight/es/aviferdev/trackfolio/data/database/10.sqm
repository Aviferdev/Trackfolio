-- Migración v10: Categorías de activo fijas, relación activo↔plataforma,
-- FIFO por plataforma. DESTRUCTIVA: borra datos de portfolio existentes.

-- ── 1. Limpiar datos de portfolio ──────────────────────────────────────────

DELETE FROM AssetTransactionEntity;
DELETE FROM AssetEntity;
DELETE FROM AssetCategoryEntity;
DELETE FROM PlatformEntity;

-- Limpiar transacciones de ledger vinculadas a portfolio
DELETE FROM TransactionEntity WHERE linkedAssetTransactionId IS NOT NULL;

-- ── 2. Tabla relación activo↔plataforma ────────────────────────────────────

CREATE TABLE IF NOT EXISTS AssetPlatformEntity (
    assetId    TEXT NOT NULL,
    platformId TEXT NOT NULL,
    createdAt  INTEGER NOT NULL,
    PRIMARY KEY (assetId, platformId),
    FOREIGN KEY (assetId)    REFERENCES AssetEntity(id)    ON DELETE CASCADE,
    FOREIGN KEY (platformId) REFERENCES PlatformEntity(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_asset_platform_asset    ON AssetPlatformEntity(assetId);
CREATE INDEX IF NOT EXISTS idx_asset_platform_platform ON AssetPlatformEntity(platformId);

-- ── 3. Insertar categorías fijas ───────────────────────────────────────────

INSERT OR IGNORE INTO AssetCategoryEntity(id, name, icon, sortOrder, archived, createdAt)
VALUES
    ('fixed_cat_stocks',       'Acciones',              '📊', 0, 0, 0),
    ('fixed_cat_etfs',         'ETFs',                  '📈', 1, 0, 0),
    ('fixed_cat_funds',        'Fondos de inversión',   '💼', 2, 0, 0),
    ('fixed_cat_crypto',       'Criptomonedas',         '₿',  3, 0, 0),
    ('fixed_cat_bonds',        'Bonos / Deuda pública', '📜', 4, 0, 0),
    ('fixed_cat_deposits',     'Depósitos bancarios',   '🏦', 5, 0, 0),
    ('fixed_cat_pensions',     'Planes de pensiones',   '🛡', 6, 0, 0),
    ('fixed_cat_commodities',  'Materias primas',       '🪙', 7, 0, 0),
    ('fixed_cat_crowdlending', 'Crowdlending',          '🤝', 8, 0, 0);
