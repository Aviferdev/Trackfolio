CREATE TABLE CategoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    isDefault INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM CategoryEntity ORDER BY name ASC;

selectByType:
SELECT * FROM CategoryEntity WHERE type = :type ORDER BY name ASC;

selectById:
SELECT * FROM CategoryEntity WHERE id = :id;

insert:
INSERT OR IGNORE INTO CategoryEntity(id, name, type, isDefault)
VALUES (?, ?, ?, ?);

delete:
DELETE FROM CategoryEntity WHERE id = :id AND isDefault = 0;

countAll:
SELECT COUNT(*) FROM CategoryEntity;
