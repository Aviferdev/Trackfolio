CREATE TABLE AccountEntity (
    id          TEXT    NOT NULL PRIMARY KEY,
    name        TEXT    NOT NULL,
    balance     REAL    NOT NULL DEFAULT 0.0,
    createdAt   INTEGER NOT NULL,
    accountType TEXT    NOT NULL DEFAULT 'GENERAL'
);

-- ─── Queries básicas ──────────────────────────────────────────────────────────

selectAll:
SELECT * FROM AccountEntity ORDER BY createdAt ASC;

selectById:
SELECT * FROM AccountEntity WHERE id = :id;

insert:
INSERT OR REPLACE INTO AccountEntity(id, name, balance, createdAt, accountType)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE AccountEntity
SET name = :name, accountType = :accountType
WHERE id = :id;

updateInitialBalance:
UPDATE AccountEntity SET balance = :balance WHERE id = :id;

updateAccountType:
UPDATE AccountEntity SET accountType = :accountType WHERE id = :id;

delete:
DELETE FROM AccountEntity WHERE id = :id;

-- ─── Balance calculado dinámicamente ─────────────────────────────────────────

getComputedBalance:
SELECT
    a.id,
    a.name,
    a.balance AS initialBalance,
    a.createdAt,
    a.accountType,
    COALESCE(a.balance, 0.0)
        + COALESCE(SUM(CASE WHEN t.type = 'INCOME'     THEN t.amount ELSE 0.0 END), 0.0)
        - COALESCE(SUM(CASE WHEN t.type = 'EXPENSE'    THEN t.amount ELSE 0.0 END), 0.0)
        + COALESCE(SUM(CASE WHEN t.type = 'ADJUSTMENT'  THEN t.amount ELSE 0.0 END), 0.0)
    AS computedBalance
FROM AccountEntity a
LEFT JOIN TransactionEntity t ON t.accountId = a.id
WHERE a.id = :id
GROUP BY a.id;

getAllComputedBalances:
SELECT
    a.id,
    a.name,
    a.balance AS initialBalance,
    a.createdAt,
    a.accountType,
    COALESCE(a.balance, 0.0)
        + COALESCE(SUM(CASE WHEN t.type = 'INCOME'     THEN t.amount ELSE 0.0 END), 0.0)
        - COALESCE(SUM(CASE WHEN t.type = 'EXPENSE'    THEN t.amount ELSE 0.0 END), 0.0)
        + COALESCE(SUM(CASE WHEN t.type = 'ADJUSTMENT'  THEN t.amount ELSE 0.0 END), 0.0)
    AS computedBalance
FROM AccountEntity a
LEFT JOIN TransactionEntity t ON t.accountId = a.id
GROUP BY a.id
ORDER BY a.createdAt ASC;

getTotalComputedBalance:
SELECT
    COALESCE(SUM(
        COALESCE(a.balance, 0.0)
        + COALESCE(inc.total, 0.0)
        - COALESCE(exp.total, 0.0)
        + COALESCE(adj.total, 0.0)
    ), 0.0) AS totalBalance
FROM AccountEntity a
LEFT JOIN (
    SELECT accountId, SUM(amount) AS total
    FROM TransactionEntity WHERE type = 'INCOME'
    GROUP BY accountId
) inc ON inc.accountId = a.id
LEFT JOIN (
    SELECT accountId, SUM(amount) AS total
    FROM TransactionEntity WHERE type = 'EXPENSE'
    GROUP BY accountId
) exp ON exp.accountId = a.id
LEFT JOIN (
    SELECT accountId, SUM(amount) AS total
    FROM TransactionEntity WHERE type = 'ADJUSTMENT'
    GROUP BY accountId
) adj ON adj.accountId = a.id;
