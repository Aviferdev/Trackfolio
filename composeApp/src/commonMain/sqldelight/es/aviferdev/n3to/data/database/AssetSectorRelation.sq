-- AssetSectorRelationEntity: relación muchos:a muchos entre activos y sectores.

CREATE TABLE AssetSectorRelationEntity (
    assetId  TEXT NOT NULL,
    sectorId TEXT NOT NULL,
    PRIMARY KEY (assetId, sectorId),
    FOREIGN KEY (assetId)  REFERENCES AssetEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (sectorId) REFERENCES AssetSectorEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_asset_sector_rel_sector ON AssetSectorRelationEntity(sectorId);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

selectByAsset:
SELECT * FROM AssetSectorRelationEntity WHERE assetId = :assetId;

selectBySector:
SELECT * FROM AssetSectorRelationEntity WHERE sectorId = :sectorId;

selectAllByAssets:
SELECT * FROM AssetSectorRelationEntity WHERE assetId IN :assetIds;

-- Devuelve los sectores con sus datos directamente, evitando N+1
selectSectorsByAsset:
SELECT s.* FROM AssetSectorEntity s
INNER JOIN AssetSectorRelationEntity r ON r.sectorId = s.id
WHERE r.assetId = :assetId
ORDER BY s.name ASC;

-- ─── Escritura ──────────────────────────────────────────────────────────────────

insert:
INSERT OR IGNORE INTO AssetSectorRelationEntity(assetId, sectorId)
VALUES (:assetId, :sectorId);

deleteByAsset:
DELETE FROM AssetSectorRelationEntity WHERE assetId = :assetId;

deleteRelation:
DELETE FROM AssetSectorRelationEntity WHERE assetId = :assetId AND sectorId = :sectorId;