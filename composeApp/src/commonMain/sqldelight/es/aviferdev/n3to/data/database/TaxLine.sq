CREATE TABLE TaxLineEntity (
    id            TEXT NOT NULL PRIMARY KEY,
    transactionId TEXT NOT NULL,
    name          TEXT NOT NULL,
    role          TEXT NOT NULL,
    percent       REAL,
    amount        REAL NOT NULL,
    createdAt     INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (transactionId) REFERENCES TransactionEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_taxline_transaction ON TaxLineEntity(transactionId);

-- ─── Queries ──────────────────────────────────────────────────────────────────

selectByTransaction:
SELECT * FROM TaxLineEntity WHERE transactionId = :transactionId;

insert:
INSERT INTO TaxLineEntity(id, transactionId, name, role, percent, amount, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteByTransaction:
DELETE FROM TaxLineEntity WHERE transactionId = :transactionId;
