-- AssetEntity: catálogo del activo.
--
-- `currentPrice` / `currentPriceUpdatedAt`: cotización actual editable.
-- No aplica a renta fija (bonos/depósitos) — se deja NULL.
--
-- `maturityDate`: fecha de vencimiento (epoch millis). Solo aplica a
-- bonos y depósitos bancarios.
--
-- `archived`: los activos NUNCA se borran, solo se archivan.

CREATE TABLE AssetEntity (
    id                     TEXT    NOT NULL PRIMARY KEY,
    accountId              TEXT    NOT NULL,
    portfolioId            TEXT,
    ticker                 TEXT    NOT NULL,
    name                   TEXT    NOT NULL,
    notes                  TEXT,
    createdAt              INTEGER NOT NULL,
    assetCategoryId        TEXT,
    currentPrice           REAL,
    currentPriceUpdatedAt  INTEGER,
    archived               INTEGER NOT NULL DEFAULT 0,
    maturityDate           INTEGER,
    isin                   TEXT,
    priceSource            TEXT    NOT NULL DEFAULT 'MANUAL',
    isinValidatedAt        INTEGER,
    isinValidationError    TEXT,
    fixedIncomePercent     INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (accountId)       REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (assetCategoryId) REFERENCES AssetCategoryEntity(id) ON DELETE SET NULL,
    FOREIGN KEY (portfolioId)     REFERENCES PortfolioEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_asset_account  ON AssetEntity(accountId);
CREATE INDEX idx_asset_category ON AssetEntity(assetCategoryId);
CREATE INDEX idx_asset_archived ON AssetEntity(archived);
CREATE INDEX idx_asset_portfolio ON AssetEntity(portfolioId);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

selectAll:
SELECT * FROM AssetEntity
WHERE archived = 0
ORDER BY createdAt DESC;

selectByAccount:
SELECT * FROM AssetEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY createdAt DESC;

selectAllByAccountIncludingArchived:
SELECT * FROM AssetEntity
WHERE accountId = :accountId
ORDER BY archived ASC, createdAt DESC;

selectByAccountAndCategory:
SELECT * FROM AssetEntity
WHERE accountId = :accountId AND assetCategoryId = :categoryId AND archived = 0
ORDER BY createdAt DESC;

selectById:
SELECT * FROM AssetEntity WHERE id = :id;

-- ─── Escritura ────────────────────────────────────────────────────────────────

selectByPortfolio:
SELECT * FROM AssetEntity
WHERE portfolioId = :portfolioId AND archived = 0
ORDER BY createdAt DESC;

selectByAccountWithoutPortfolio:
SELECT * FROM AssetEntity
WHERE accountId = :accountId AND portfolioId IS NULL AND archived = 0
ORDER BY createdAt DESC;

insert:
INSERT INTO AssetEntity(id, accountId, portfolioId, ticker, name, notes, createdAt, assetCategoryId, currentPrice, currentPriceUpdatedAt, archived, maturityDate, isin, priceSource, isinValidatedAt, isinValidationError, fixedIncomePercent)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE AssetEntity
SET ticker = :ticker, name = :name, notes = :notes,
    assetCategoryId = :assetCategoryId,
    portfolioId = :portfolioId,
    currentPrice = :currentPrice, currentPriceUpdatedAt = :currentPriceUpdatedAt,
    maturityDate = :maturityDate,
    isin = :isin, priceSource = :priceSource,
    isinValidatedAt = :isinValidatedAt, isinValidationError = :isinValidationError,
    fixedIncomePercent = :fixedIncomePercent
WHERE id = :id;

updateCurrentPrice:
UPDATE AssetEntity
SET currentPrice = :currentPrice, currentPriceUpdatedAt = :currentPriceUpdatedAt
WHERE id = :id;

archive:
UPDATE AssetEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE AssetEntity SET archived = 0 WHERE id = :id;

delete:
DELETE FROM AssetEntity WHERE id = :id;

-- Activos con posiciones abiertas cuyo precio no se ha actualizado
-- desde :thresholdDate. Solo activos no archivados y no de renta fija
-- (bonos/depósitos no tienen precio actual cotizado).
selectOutdatedByAccount:
SELECT a.* FROM AssetEntity a
LEFT JOIN (
    SELECT assetId,
           SUM(CASE WHEN type = 'BUY' THEN quantity ELSE 0 END) -
           SUM(CASE WHEN type = 'SELL' THEN quantity ELSE 0 END) AS openQty
    FROM AssetTransactionEntity
    GROUP BY assetId
) t ON t.assetId = a.id
WHERE a.accountId = :accountId
  AND a.archived = 0
  AND a.assetCategoryId NOT IN ('fixed_cat_fixedincome')
  AND COALESCE(t.openQty, 0) > 0
  AND (a.currentPriceUpdatedAt IS NULL OR a.currentPriceUpdatedAt < :thresholdDate)
ORDER BY a.name ASC;

-- ─── Nuevas queries para ISIN y auto-precio ────────────────────────────────

updateIsin:
UPDATE AssetEntity SET isin = :isin, isinValidatedAt = :validatedAt WHERE id = :id;

updatePriceSource:
UPDATE AssetEntity SET priceSource = :priceSource WHERE id = :id;

markIsinValidationError:
UPDATE AssetEntity SET isinValidationError = :error WHERE id = :id;

selectQuotableByAccount:
SELECT * FROM AssetEntity
WHERE accountId = :accountId
  AND archived = 0
  AND isin IS NOT NULL
  AND isin != ''
  AND assetCategoryId IN ('fixed_cat_stocks', 'fixed_cat_etfs', 'fixed_cat_funds', 'fixed_cat_crypto', 'fixed_cat_commodities')
ORDER BY name ASC;

selectAssetsWithBrokenIsin:
SELECT * FROM AssetEntity
WHERE accountId = :accountId
  AND archived = 0
  AND isin IS NOT NULL
  AND isin != ''
  AND isinValidationError IS NOT NULL
ORDER BY name ASC;
