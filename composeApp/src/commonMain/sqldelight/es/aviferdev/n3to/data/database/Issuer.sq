-- IssuerEntity: catálogo unificado de emisores (bancos, empleadores, etc.).
-- Reemplaza las 6 tablas BankEntity, BondIssuerEntity, DividendSourceEntity,
-- EmployerEntity, ExemptSourceEntity, PromotionPlatformEntity.
--
-- type: IssuerType.name (EMPLOYER, BANK, BOND_ISSUER, DIVIDEND_SOURCE,
--       PROMOTION_PLATFORM, EXEMPT_SOURCE)

CREATE TABLE IssuerEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🏢',
    type      TEXT    NOT NULL CHECK(type IN ('EMPLOYER', 'BANK', 'BOND_ISSUER', 'DIVIDEND_SOURCE', 'PROMOTION_PLATFORM', 'EXEMPT_SOURCE')),
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_issuer_account  ON IssuerEntity(accountId);
CREATE INDEX idx_issuer_archived ON IssuerEntity(archived);
CREATE INDEX idx_issuer_type     ON IssuerEntity(type);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

selectByAccount:
SELECT * FROM IssuerEntity
WHERE accountId = :accountId AND type = :type AND archived = 0
ORDER BY name ASC;

selectAllByAccount:
SELECT * FROM IssuerEntity
WHERE accountId = :accountId AND type = :type
ORDER BY archived ASC, name ASC;

selectById:
SELECT * FROM IssuerEntity WHERE id = :id;

-- ─── Escritura ────────────────────────────────────────────────────────────────

insert:
INSERT OR IGNORE INTO IssuerEntity(id, accountId, name, icon, type, archived, createdAt)
VALUES (?, ?, ?, ?, ?, 0, ?);

updateName:
UPDATE IssuerEntity SET name = :name, icon = :icon WHERE id = :id;

archive:
UPDATE IssuerEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE IssuerEntity SET archived = 0 WHERE id = :id;

delete:
DELETE FROM IssuerEntity WHERE id = :id;
