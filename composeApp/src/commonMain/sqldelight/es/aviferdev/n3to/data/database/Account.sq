CREATE TABLE AccountEntity (
    id              TEXT    NOT NULL PRIMARY KEY,
    name            TEXT    NOT NULL,
    initialBalance  REAL    NOT NULL DEFAULT 0.0,
    createdAt       INTEGER NOT NULL,
    currency        TEXT    NOT NULL DEFAULT 'EUR',
    archived        INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_account_archived ON AccountEntity(archived);

-- ─── Queries básicas ──────────────────────────────────────────────────────────

selectAll:
SELECT * FROM AccountEntity WHERE archived = 0 ORDER BY createdAt ASC;

selectById:
SELECT * FROM AccountEntity WHERE id = :id;

countAll:
SELECT COUNT(*) FROM AccountEntity WHERE archived = 0;

insert:
INSERT INTO AccountEntity(id, name, initialBalance, createdAt, currency)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE AccountEntity SET name = :name WHERE id = :id;

updateInitialBalance:
UPDATE AccountEntity SET initialBalance = :initialBalance WHERE id = :id;

archive:
UPDATE AccountEntity SET archived = 1 WHERE id = :id;

delete:
DELETE FROM AccountEntity WHERE id = :id;

-- ─── Balance calculado dinámicamente ─────────────────────────────────────────

getComputedBalance:
SELECT
    a.id,
    a.name,
    a.initialBalance,
    a.createdAt,
    a.currency,
    a.archived,
    a.initialBalance
        + COALESCE(SUM(CASE WHEN t.type = 'INCOME'     THEN t.amount ELSE 0.0 END), 0.0)
        - COALESCE(SUM(CASE WHEN t.type = 'EXPENSE'    THEN t.amount ELSE 0.0 END), 0.0)
        + COALESCE(SUM(CASE WHEN t.type = 'ADJUSTMENT'  THEN t.amount ELSE 0.0 END), 0.0)
    AS computedBalance
FROM AccountEntity a
LEFT JOIN TransactionEntity t ON t.accountId = a.id
WHERE a.id = :id
GROUP BY a.id;

getAllComputedBalances:
SELECT
    a.id,
    a.name,
    a.initialBalance,
    a.createdAt,
    a.currency,
    a.archived,
    a.initialBalance
        + COALESCE(SUM(CASE WHEN t.type = 'INCOME'     THEN t.amount ELSE 0.0 END), 0.0)
        - COALESCE(SUM(CASE WHEN t.type = 'EXPENSE'    THEN t.amount ELSE 0.0 END), 0.0)
        + COALESCE(SUM(CASE WHEN t.type = 'ADJUSTMENT'  THEN t.amount ELSE 0.0 END), 0.0)
    AS computedBalance
FROM AccountEntity a
LEFT JOIN TransactionEntity t ON t.accountId = a.id
WHERE a.archived = 0
GROUP BY a.id
ORDER BY a.createdAt ASC;

getTotalComputedBalance:
SELECT
    COALESCE(SUM(a.initialBalance), 0.0)
    + COALESCE(SUM(t.netBalance), 0.0) AS totalBalance
FROM AccountEntity a
LEFT JOIN (
    SELECT accountId,
        SUM(CASE WHEN type = 'INCOME' THEN amount ELSE 0.0 END)
        - SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0.0 END)
        + SUM(CASE WHEN type = 'ADJUSTMENT' THEN amount ELSE 0.0 END) AS netBalance
    FROM TransactionEntity
    GROUP BY accountId
) t ON t.accountId = a.id
WHERE a.archived = 0;
