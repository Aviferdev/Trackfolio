CREATE TABLE AssetPriceHistoryEntity (
    id         TEXT    NOT NULL PRIMARY KEY,
    assetId    TEXT    NOT NULL,
    price      REAL    NOT NULL,
    recordedAt INTEGER NOT NULL,
    FOREIGN KEY (assetId) REFERENCES AssetEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_price_history_asset      ON AssetPriceHistoryEntity(assetId);
CREATE INDEX idx_price_history_date       ON AssetPriceHistoryEntity(recordedAt);
CREATE INDEX idx_price_history_asset_date ON AssetPriceHistoryEntity(assetId, recordedAt);

selectByAsset:
SELECT * FROM AssetPriceHistoryEntity
WHERE assetId = :assetId
ORDER BY recordedAt DESC;

selectByAccount:
SELECT aph.* FROM AssetPriceHistoryEntity aph
INNER JOIN AssetEntity a ON a.id = aph.assetId
WHERE a.accountId = :accountId
ORDER BY aph.recordedAt ASC;

selectByAssetInRange:
SELECT * FROM AssetPriceHistoryEntity
WHERE assetId = :assetId AND recordedAt >= :fromDate AND recordedAt <= :toDate
ORDER BY recordedAt ASC;

insert:
INSERT INTO AssetPriceHistoryEntity(id, assetId, price, recordedAt)
VALUES (?, ?, ?, ?);

deleteByAsset:
DELETE FROM AssetPriceHistoryEntity WHERE assetId = :assetId;
