CREATE TABLE CategoryEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    type      TEXT    NOT NULL CHECK(type IN ('INCOME', 'EXPENSE')),
    isDefault INTEGER NOT NULL DEFAULT 0,
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_category_account           ON CategoryEntity(accountId);
CREATE INDEX idx_category_account_type_archived ON CategoryEntity(accountId, type, archived);
CREATE INDEX idx_category_archived           ON CategoryEntity(archived);

-- ─── Lectura por cuenta (filtradas por accountId + no archivadas) ──────────

selectAll:
SELECT * FROM CategoryEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY name ASC;

selectByType:
SELECT * FROM CategoryEntity
WHERE accountId = :accountId AND type = :type AND archived = 0
ORDER BY name ASC;

selectAllIncludingArchived:
SELECT * FROM CategoryEntity
WHERE accountId = :accountId
ORDER BY name ASC;

selectByTypeIncludingArchived:
SELECT * FROM CategoryEntity
WHERE accountId = :accountId AND type = :type
ORDER BY name ASC;

-- ─── Lectura por ID (no necesita accountId) ──────────────────────────────

selectById:
SELECT * FROM CategoryEntity WHERE id = :id;

countAll:
SELECT COUNT(*) FROM CategoryEntity WHERE accountId = :accountId AND archived = 0;

-- ─── Escritura ───────────────────────────────────────────────────────────

insert:
INSERT OR IGNORE INTO CategoryEntity(id, accountId, name, type, isDefault, archived, createdAt)
VALUES (?, ?, ?, ?, ?, 0, ?);

updateName:
UPDATE CategoryEntity SET name = :name WHERE id = :id;

archive:
UPDATE CategoryEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE CategoryEntity SET archived = 0 WHERE id = :id;
