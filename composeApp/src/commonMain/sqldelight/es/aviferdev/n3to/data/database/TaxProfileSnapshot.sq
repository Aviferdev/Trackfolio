CREATE TABLE TaxProfileSnapshotEntity (
    id            TEXT NOT NULL PRIMARY KEY,
    countryCode   TEXT,
    currency      TEXT NOT NULL,
    effectiveFrom TEXT NOT NULL  -- ISO date "YYYY-MM-DD"
);

CREATE INDEX idx_snapshot_effective_from ON TaxProfileSnapshotEntity(effectiveFrom);
CREATE INDEX idx_snapshot_country ON TaxProfileSnapshotEntity(countryCode);

-- ─── Queries ──────────────────────────────────────────────────────────────────

selectAll:
SELECT * FROM TaxProfileSnapshotEntity ORDER BY effectiveFrom ASC;

selectActive:
SELECT * FROM TaxProfileSnapshotEntity
WHERE effectiveFrom <= :isoDate
ORDER BY effectiveFrom DESC
LIMIT 1;

insert:
INSERT INTO TaxProfileSnapshotEntity(id, countryCode, currency, effectiveFrom)
VALUES (?, ?, ?, ?);

delete:
DELETE FROM TaxProfileSnapshotEntity WHERE id = :id;
