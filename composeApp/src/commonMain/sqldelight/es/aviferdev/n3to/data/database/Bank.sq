CREATE TABLE BankEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🏦',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_bank_account  ON BankEntity(accountId);
CREATE INDEX idx_bank_archived ON BankEntity(archived);

selectByAccount:
SELECT * FROM BankEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY name ASC;

selectAllByAccount:
SELECT * FROM BankEntity
WHERE accountId = :accountId
ORDER BY archived ASC, name ASC;

selectById:
SELECT * FROM BankEntity WHERE id = :id;

insert:
INSERT OR IGNORE INTO BankEntity(id, accountId, name, icon, archived, createdAt)
VALUES (?, ?, ?, ?, 0, ?);

updateName:
UPDATE BankEntity SET name = :name, icon = :icon WHERE id = :id;

archive:
UPDATE BankEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE BankEntity SET archived = 0 WHERE id = :id;
