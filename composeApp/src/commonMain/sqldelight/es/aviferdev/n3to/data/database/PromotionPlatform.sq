CREATE TABLE PromotionPlatformEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '🎁',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_promo_platform_account  ON PromotionPlatformEntity(accountId);
CREATE INDEX idx_promo_platform_archived ON PromotionPlatformEntity(archived);

selectByAccount:
SELECT * FROM PromotionPlatformEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY name ASC;

selectAllByAccount:
SELECT * FROM PromotionPlatformEntity
WHERE accountId = :accountId
ORDER BY archived ASC, name ASC;

selectById:
SELECT * FROM PromotionPlatformEntity WHERE id = :id;

insert:
INSERT OR IGNORE INTO PromotionPlatformEntity(id, accountId, name, icon, archived, createdAt)
VALUES (?, ?, ?, ?, 0, ?);

updateName:
UPDATE PromotionPlatformEntity SET name = :name, icon = :icon WHERE id = :id;

archive:
UPDATE PromotionPlatformEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE PromotionPlatformEntity SET archived = 0 WHERE id = :id;
