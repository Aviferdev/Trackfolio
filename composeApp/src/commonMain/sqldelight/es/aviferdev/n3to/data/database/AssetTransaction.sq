-- Movimientos (compra/venta/traspaso) de un activo. Cada movimiento tiene su
-- fecha propia y la plataforma donde se ejecutó. El P&L del activo se deriva
-- en el dominio agregando todos sus movimientos en orden cronológico (FIFO).
--
-- type: BUY / SELL / TRANSFER_OUT / TRANSFER_IN
--   TRANSFER_OUT: resta participaciones sin generar P&L (traspaso entre fondos).
--   TRANSFER_IN:  suma participaciones arrastrando el coste base FIFO del origen.
--   feeNote: texto libre informativo, NO entra en cálculos.

CREATE TABLE AssetTransactionEntity (
    id            TEXT    NOT NULL PRIMARY KEY,
    assetId       TEXT    NOT NULL,
    type          TEXT    NOT NULL CHECK(type IN ('BUY', 'SELL', 'TRANSFER_OUT', 'TRANSFER_IN')),
    quantity      REAL    NOT NULL,
    pricePerUnit  REAL    NOT NULL,
    date          INTEGER NOT NULL,
    platformId    TEXT    NOT NULL,
    feeNote       TEXT,
    notes         TEXT,
    createdAt     INTEGER NOT NULL,
    FOREIGN KEY (assetId)    REFERENCES AssetEntity(id)    ON DELETE CASCADE,
    FOREIGN KEY (platformId) REFERENCES PlatformEntity(id) ON DELETE RESTRICT
);

CREATE INDEX idx_asset_tx_asset      ON AssetTransactionEntity(assetId);
CREATE INDEX idx_asset_tx_asset_date ON AssetTransactionEntity(assetId, date);
CREATE INDEX idx_asset_tx_platform   ON AssetTransactionEntity(platformId);
CREATE INDEX idx_asset_tx_date       ON AssetTransactionEntity(date);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

selectByAsset:
SELECT * FROM AssetTransactionEntity
WHERE assetId = :assetId
ORDER BY date ASC, createdAt ASC;

selectByAssetDesc:
SELECT * FROM AssetTransactionEntity
WHERE assetId = :assetId
ORDER BY date DESC, createdAt DESC;

selectByAccount:
SELECT t.* FROM AssetTransactionEntity t
INNER JOIN AssetEntity a ON a.id = t.assetId
WHERE a.accountId = :accountId
ORDER BY t.date ASC, t.createdAt ASC;

selectById:
SELECT * FROM AssetTransactionEntity WHERE id = :id;

countByPlatform:
SELECT COUNT(*) FROM AssetTransactionEntity WHERE platformId = :platformId;

-- ─── Escritura ────────────────────────────────────────────────────────────────

insert:
INSERT INTO AssetTransactionEntity(id, assetId, type, quantity, pricePerUnit, date, platformId, feeNote, notes, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE AssetTransactionEntity
SET type = :type, quantity = :quantity, pricePerUnit = :pricePerUnit,
    date = :date,
    platformId = :platformId, feeNote = :feeNote, notes = :notes
WHERE id = :id;

delete:
DELETE FROM AssetTransactionEntity WHERE id = :id;

deleteByAsset:
DELETE FROM AssetTransactionEntity WHERE assetId = :assetId;

getOldestDateByAccount:
SELECT MIN(t.date) AS oldestDate FROM AssetTransactionEntity t
INNER JOIN AssetEntity a ON a.id = t.assetId
WHERE a.accountId = :accountId;

-- ─── Inversión mensual (compras) por año ──────────────────────────────────────
getMonthlyInvestmentsByYear:
SELECT
    strftime('%m', t.date / 1000, 'unixepoch') AS month,
    SUM(t.quantity * t.pricePerUnit) AS totalInvested
FROM AssetTransactionEntity t
INNER JOIN AssetEntity a ON a.id = t.assetId
WHERE a.accountId = :accountId
  AND t.type = 'BUY'
  AND t.date >= :yearStartEpoch AND t.date < :yearEndEpoch
GROUP BY month
ORDER BY month ASC;

-- ─── Inversión neta mensual (BUY - SELL) por año ──────────────────────────────
-- Excluye TRANSFER_IN / TRANSFER_OUT para que solo refleje dinero nuevo.
getMonthlyNetInvestmentsByYear:
SELECT
    strftime('%m', t.date / 1000, 'unixepoch') AS month,
    SUM(CASE WHEN t.type = 'BUY'  THEN t.quantity * t.pricePerUnit ELSE 0.0 END) -
    SUM(CASE WHEN t.type = 'SELL' THEN t.quantity * t.pricePerUnit ELSE 0.0 END) AS netInvested
FROM AssetTransactionEntity t
INNER JOIN AssetEntity a ON a.id = t.assetId
WHERE a.accountId = :accountId
  AND t.date >= :yearStartEpoch AND t.date < :yearEndEpoch
GROUP BY month
ORDER BY month ASC;

getMonthlyNetInvestmentByMonth:
SELECT
    SUM(CASE WHEN t.type = 'BUY'  THEN t.quantity * t.pricePerUnit ELSE 0.0 END) -
    SUM(CASE WHEN t.type = 'SELL' THEN t.quantity * t.pricePerUnit ELSE 0.0 END) AS netInvested
FROM AssetTransactionEntity t
INNER JOIN AssetEntity a ON a.id = t.assetId
WHERE a.accountId = :accountId
  AND t.date >= :monthStartEpoch AND t.date < :monthEndEpoch;
