CREATE TABLE ValuableEntity (
    id               TEXT    NOT NULL PRIMARY KEY,
    accountId        TEXT    NOT NULL,
    name             TEXT    NOT NULL,
    description      TEXT    NOT NULL DEFAULT '',
    purchasePrice    REAL    NOT NULL,
    purchaseDate     INTEGER NOT NULL,
    estimatedValue   REAL,
    salePrice        REAL,
    saleDate         INTEGER,
    closeType        TEXT    CHECK(closeType IS NULL OR closeType IN ('SOLD', 'SCRAPPED', 'DONATED', 'TRANSFERRED', 'LOST')),
    linkedLoanId     TEXT,
    notes            TEXT,
    archived         INTEGER NOT NULL DEFAULT 0,
    createdAt        INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (linkedLoanId) REFERENCES LoanEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_valuable_account  ON ValuableEntity(accountId);
CREATE INDEX idx_valuable_loan     ON ValuableEntity(linkedLoanId);
CREATE INDEX idx_valuable_archived ON ValuableEntity(archived);

-- ═══ LECTURA ═══

selectByAccount:
SELECT * FROM ValuableEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY saleDate IS NULL DESC, purchaseDate DESC;

selectActiveByAccount:
SELECT * FROM ValuableEntity
WHERE accountId = :accountId
  AND saleDate IS NULL AND archived = 0
ORDER BY purchaseDate DESC;

selectById:
SELECT * FROM ValuableEntity
WHERE id = :id;

-- ═══ ESCRITURA ═══

insert:
INSERT INTO ValuableEntity(
    id, accountId, name, description,
    purchasePrice, purchaseDate, estimatedValue,
    salePrice, saleDate, closeType, linkedLoanId,
    notes, archived, createdAt
) VALUES (
    :id, :accountId, :name, :description,
    :purchasePrice, :purchaseDate, :estimatedValue,
    :salePrice, :saleDate, :closeType, :linkedLoanId,
    :notes, :archived, :createdAt
);

sell:
UPDATE ValuableEntity
SET salePrice = :salePrice,
    saleDate  = :saleDate,
    closeType = :closeType
WHERE id = :id AND archived = 0;

updateEstimatedValue:
UPDATE ValuableEntity
SET estimatedValue = :value
WHERE id = :id AND archived = 0;

updateLinkedLoan:
UPDATE ValuableEntity
SET linkedLoanId = :loanId
WHERE id = :id;

archive:
UPDATE ValuableEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE ValuableEntity SET archived = 0 WHERE id = :id;

deleteById:
DELETE FROM ValuableEntity WHERE id = :id AND archived = 0;
