-- Objetivos financieros mensuales por cuenta.
-- Cada fila representa los objetivos de ahorro e inversión neta.
--
-- Convención:
--   month = "00" → objetivo BASE del año (se aplica a todos los meses por defecto)
--   month = "01".."12" → OVERRIDE para un mes concreto
--
-- Para obtener el objetivo efectivo de un mes: si existe override, usarlo;
-- si no, usar el base (month="00").
--
-- savingsTarget:      Objetivo de ahorro (income - expense) en euros.
-- investmentTarget:   Objetivo de inversión neta (BUY - SELL) en euros.

CREATE TABLE MonthlyGoalEntity (
    accountId TEXT NOT NULL,
    year TEXT NOT NULL,
    month TEXT NOT NULL,
    savingsTarget REAL NOT NULL DEFAULT 0.0,
    investmentTarget REAL NOT NULL DEFAULT 0.0,
    PRIMARY KEY (accountId, year, month)
);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

getByAccountYear:
SELECT * FROM MonthlyGoalEntity
WHERE accountId = :accountId AND year = :year
ORDER BY month ASC;

getByAccountYearMonth:
SELECT * FROM MonthlyGoalEntity
WHERE accountId = :accountId AND year = :year AND month = :month;

getBaseByAccountYear:
SELECT * FROM MonthlyGoalEntity
WHERE accountId = :accountId AND year = :year AND month = '00';

getOverridesByAccountYear:
SELECT * FROM MonthlyGoalEntity
WHERE accountId = :accountId AND year = :year AND month != '00'
ORDER BY month ASC;

-- ─── Escritura ────────────────────────────────────────────────────────────────

upsert:
INSERT OR REPLACE INTO MonthlyGoalEntity (accountId, year, month, savingsTarget, investmentTarget)
VALUES (:accountId, :year, :month, :savingsTarget, :investmentTarget);

deleteByAccountYearMonth:
DELETE FROM MonthlyGoalEntity
WHERE accountId = :accountId AND year = :year AND month = :month;

deleteByAccountYear:
DELETE FROM MonthlyGoalEntity
WHERE accountId = :accountId AND year = :year;
