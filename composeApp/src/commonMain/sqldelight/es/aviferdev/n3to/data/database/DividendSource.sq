CREATE TABLE DividendSourceEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    accountId TEXT    NOT NULL,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '📈',
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_dividend_source_account  ON DividendSourceEntity(accountId);
CREATE INDEX idx_dividend_source_archived ON DividendSourceEntity(archived);

selectByAccount:
SELECT * FROM DividendSourceEntity
WHERE accountId = :accountId AND archived = 0
ORDER BY name ASC;

selectAllByAccount:
SELECT * FROM DividendSourceEntity
WHERE accountId = :accountId
ORDER BY archived ASC, name ASC;

selectById:
SELECT * FROM DividendSourceEntity WHERE id = :id;

insert:
INSERT OR IGNORE INTO DividendSourceEntity(id, accountId, name, icon, archived, createdAt)
VALUES (?, ?, ?, ?, 0, ?);

updateName:
UPDATE DividendSourceEntity SET name = :name, icon = :icon WHERE id = :id;

archive:
UPDATE DividendSourceEntity SET archived = 1 WHERE id = :id;

unarchive:
UPDATE DividendSourceEntity SET archived = 0 WHERE id = :id;
