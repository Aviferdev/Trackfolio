CREATE TABLE TransactionEntity (
    id                         TEXT    NOT NULL PRIMARY KEY,
    accountId                  TEXT    NOT NULL,
    amount                     REAL    NOT NULL,
    type                       TEXT    NOT NULL CHECK(type IN ('INCOME', 'EXPENSE', 'ADJUSTMENT')),
    categoryId                 TEXT,
    date                       INTEGER NOT NULL,
    notes                      TEXT,
    createdAt                  INTEGER NOT NULL,
    excludeFromFiscal          INTEGER NOT NULL DEFAULT 0,
    -- ── Campos de ingreso ─────────────────────────────────────────────────────
    incomeType                 TEXT,
    grossAmount                REAL,
    commissionAmount           REAL,
    issuerId                   TEXT,
    issuerName                 TEXT,
    -- ── Divisa original (si difiere de la cuenta) ────────────────────────────
    originalCurrency           TEXT,
    originalAmount             REAL,
    exchangeRate               REAL,
    -- ── Vínculo con portfolio ─────────────────────────────────────────────────
    linkedAssetTransactionId   TEXT,
    -- ── Vínculo con préstamo ──────────────────────────────────────────────────
    linkedLoanId               TEXT,
    -- ── Vínculo con propiedad inmobiliaria ─────────────────────────────────────
    linkedPropertyId           TEXT,
    -- ── Vínculo con bienes (Valuable) ──────────────────────────────────────────
    linkedValuableId          TEXT,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id) ON DELETE SET NULL,
    FOREIGN KEY (linkedLoanId) REFERENCES LoanEntity(id) ON DELETE SET NULL,
    FOREIGN KEY (linkedPropertyId) REFERENCES RealEstatePropertyEntity(id) ON DELETE SET NULL,
    FOREIGN KEY (linkedValuableId) REFERENCES ValuableEntity(id) ON DELETE SET NULL
);

CREATE INDEX idx_transaction_account ON TransactionEntity(accountId);
CREATE INDEX idx_transaction_date    ON TransactionEntity(date);
CREATE INDEX idx_transaction_type    ON TransactionEntity(type);
CREATE INDEX idx_transaction_category     ON TransactionEntity(categoryId);
CREATE INDEX idx_transaction_linked_property ON TransactionEntity(linkedPropertyId);
CREATE INDEX idx_transaction_linked_valuable ON TransactionEntity(linkedValuableId);
CREATE INDEX idx_transaction_linked_asset_tx ON TransactionEntity(linkedAssetTransactionId);

-- ─── Queries básicas ──────────────────────────────────────────────────────────

selectAll:
SELECT * FROM TransactionEntity ORDER BY date DESC;

selectById:
SELECT * FROM TransactionEntity WHERE id = :id;

selectByAccount:
SELECT * FROM TransactionEntity
WHERE accountId = :accountId
ORDER BY date DESC;

-- ─── Filtradas por cuenta + mes/año ──────────────────────────────────────────

selectByMonthAndAccount:
SELECT * FROM TransactionEntity
WHERE accountId = :accountId
  AND strftime('%Y', date / 1000, 'unixepoch') = :year
  AND strftime('%m', date / 1000, 'unixepoch') = :month
ORDER BY date DESC;

selectRecentByAccount:
SELECT * FROM TransactionEntity
WHERE accountId = :accountId
ORDER BY date DESC
LIMIT :limit;

-- ─── Totales de ingresos/gastos REALES ───────────────────────────────────────

getMonthlyTotalsByAccount:
SELECT
    COALESCE(SUM(CASE WHEN type = 'INCOME'  THEN amount ELSE 0.0 END), 0.0) AS totalIncome,
    COALESCE(SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0.0 END), 0.0) AS totalExpense
FROM TransactionEntity
WHERE accountId = :accountId
  AND linkedAssetTransactionId IS NULL
  AND strftime('%Y', date / 1000, 'unixepoch') = :year
  AND strftime('%m', date / 1000, 'unixepoch') = :month;

getAnnualTotalsByAccount:
SELECT
    COALESCE(SUM(CASE WHEN type = 'INCOME'  THEN amount ELSE 0.0 END), 0.0) AS totalIncome,
    COALESCE(SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0.0 END), 0.0) AS totalExpense
FROM TransactionEntity
WHERE accountId = :accountId
  AND linkedAssetTransactionId IS NULL
  AND strftime('%Y', date / 1000, 'unixepoch') = :year;

getMonthlyBreakdownByAccount:
SELECT
    strftime('%m', date / 1000, 'unixepoch') AS month,
    COALESCE(SUM(CASE WHEN type = 'INCOME'  THEN amount ELSE 0.0 END), 0.0) AS totalIncome,
    COALESCE(SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0.0 END), 0.0) AS totalExpense
FROM TransactionEntity
WHERE accountId = :accountId
  AND linkedAssetTransactionId IS NULL
  AND strftime('%Y', date / 1000, 'unixepoch') = :year
GROUP BY month
ORDER BY month ASC;

-- ─── Ingresos del año (para informe fiscal) ──────────────────────────────────

getIncomeByYear:
SELECT * FROM TransactionEntity
WHERE accountId = :accountId
  AND type = 'INCOME'
  AND strftime('%Y', date / 1000, 'unixepoch') = :year
ORDER BY date DESC;

-- ─── Búsqueda ─────────────────────────────────────────────────────────────────

searchByAccountAndText:
SELECT * FROM TransactionEntity
WHERE accountId = :accountId
  AND (notes LIKE :query OR issuerName LIKE :query)
ORDER BY date DESC;

-- ─── Retrocompatibilidad (sin filtro de cuenta) ───────────────────────────────

selectByMonth:
SELECT * FROM TransactionEntity
WHERE strftime('%Y', date / 1000, 'unixepoch') = :year
AND strftime('%m', date / 1000, 'unixepoch') = :month
ORDER BY date DESC;

getMonthlyTotals:
SELECT
    COALESCE(SUM(CASE WHEN type = 'INCOME' THEN amount ELSE 0 END), 0.0) AS totalIncome,
    COALESCE(SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0 END), 0.0) AS totalExpense
FROM TransactionEntity
WHERE linkedAssetTransactionId IS NULL
  AND strftime('%Y', date / 1000, 'unixepoch') = :year
  AND strftime('%m', date / 1000, 'unixepoch') = :month;

getAnnualTotals:
SELECT
    COALESCE(SUM(CASE WHEN type = 'INCOME' THEN amount ELSE 0 END), 0.0) AS totalIncome,
    COALESCE(SUM(CASE WHEN type = 'EXPENSE' THEN amount ELSE 0 END), 0.0) AS totalExpense
FROM TransactionEntity
WHERE linkedAssetTransactionId IS NULL
  AND strftime('%Y', date / 1000, 'unixepoch') = :year;

-- ─── CRUD ─────────────────────────────────────────────────────────────────────

insert:
INSERT INTO TransactionEntity(
    id, accountId, amount, type, categoryId, date, notes, createdAt,
    excludeFromFiscal,
    incomeType, grossAmount, commissionAmount, issuerId, issuerName,
    originalCurrency, originalAmount, exchangeRate,
    linkedAssetTransactionId, linkedLoanId, linkedPropertyId, linkedValuableId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE TransactionEntity
SET accountId                = :accountId,
    amount                   = :amount,
    type                     = :type,
    categoryId               = :categoryId,
    date                     = :date,
    notes                    = :notes,
    excludeFromFiscal        = :excludeFromFiscal,
    incomeType               = :incomeType,
    grossAmount              = :grossAmount,
    commissionAmount         = :commissionAmount,
    issuerId                 = :issuerId,
    issuerName               = :issuerName,
    originalCurrency         = :originalCurrency,
    originalAmount           = :originalAmount,
    exchangeRate             = :exchangeRate,
    linkedAssetTransactionId = :linkedAssetTransactionId,
    linkedLoanId             = :linkedLoanId,
    linkedPropertyId         = :linkedPropertyId,
    linkedValuableId         = :linkedValuableId
WHERE id = :id;

delete:
DELETE FROM TransactionEntity WHERE id = :id;

-- ─── Portfolio link ───────────────────────────────────────────────────────────

deleteByLinkedAssetTransaction:
DELETE FROM TransactionEntity WHERE linkedAssetTransactionId = :assetTxId;

selectByLinkedAssetTransaction:
SELECT * FROM TransactionEntity WHERE linkedAssetTransactionId = :assetTxId LIMIT 1;

selectByLinkedProperty:
SELECT * FROM TransactionEntity WHERE linkedPropertyId = :propertyId ORDER BY date DESC;

selectByLinkedValuable:
SELECT * FROM TransactionEntity WHERE linkedValuableId = :valuableId ORDER BY date DESC;

getOldestDateByAccount:
SELECT MIN(d) AS oldestDate FROM (
    SELECT date AS d FROM TransactionEntity WHERE accountId = :accountId
    UNION ALL
    SELECT t.date AS d FROM AssetTransactionEntity t
    JOIN AssetEntity a ON a.id = t.assetId
    WHERE a.accountId = :accountId
);

getDividendsByAssetId:
SELECT * FROM TransactionEntity
WHERE linkedAssetTransactionId LIKE ('div_' || :assetId || '_%')
  AND incomeType = 'DIVIDEND'
ORDER BY date DESC;

-- ─── Desglose de gastos por categoría (año) ────────────────────────────────────

getExpensesByCategoryPerYear:
SELECT
    t.categoryId,
    COALESCE(c.name, 'Sin categoría') AS categoryName,
    SUM(t.amount) AS totalAmount
FROM TransactionEntity t
LEFT JOIN CategoryEntity c ON t.categoryId = c.id
WHERE t.accountId = :accountId
  AND t.type = 'EXPENSE'
  AND t.linkedAssetTransactionId IS NULL
  AND strftime('%Y', t.date / 1000, 'unixepoch') = :year
GROUP BY t.categoryId
ORDER BY totalAmount DESC;

-- ─── Desglose de ingresos por tipo (año) ─────────────────────────────────────

getIncomeByTypePerYear:
SELECT
    t.incomeType,
    SUM(t.amount) AS totalAmount
FROM TransactionEntity t
WHERE t.accountId = :accountId
  AND t.type = 'INCOME'
  AND t.linkedAssetTransactionId IS NULL
  AND strftime('%Y', t.date / 1000, 'unixepoch') = :year
GROUP BY t.incomeType
ORDER BY totalAmount DESC;

-- ─── Desglose de gastos por categoría (mes) ──────────────────────────────────

getExpensesByCategoryPerMonth:
SELECT
    t.categoryId,
    COALESCE(c.name, 'Sin categoría') AS categoryName,
    SUM(t.amount) AS totalAmount
FROM TransactionEntity t
LEFT JOIN CategoryEntity c ON t.categoryId = c.id
WHERE t.accountId = :accountId
  AND t.type = 'EXPENSE'
  AND t.linkedAssetTransactionId IS NULL
  AND strftime('%Y', t.date / 1000, 'unixepoch') = :year
  AND strftime('%m', t.date / 1000, 'unixepoch') = :month
GROUP BY t.categoryId
ORDER BY totalAmount DESC;

-- ─── Desglose de ingresos por tipo (mes) ─────────────────────────────────────

getIncomeByTypePerMonth:
SELECT
    t.incomeType,
    SUM(t.amount) AS totalAmount
FROM TransactionEntity t
WHERE t.accountId = :accountId
  AND t.type = 'INCOME'
  AND t.linkedAssetTransactionId IS NULL
  AND strftime('%Y', t.date / 1000, 'unixepoch') = :year
  AND strftime('%m', t.date / 1000, 'unixepoch') = :month
GROUP BY t.incomeType
ORDER BY totalAmount DESC;
