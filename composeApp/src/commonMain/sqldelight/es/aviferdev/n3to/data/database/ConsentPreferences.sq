-- ConsentPreferencesEntity: preferencias de consentimiento GDPR/privacidad.
-- Tabla singleton (una única fila con id=1).
-- Migrada desde AppSettings (clave-valor) a SQLite para homogeneidad
-- con el resto del stack de persistencia.

CREATE TABLE ConsentPreferencesEntity (
    id               INTEGER NOT NULL PRIMARY KEY DEFAULT 1 CHECK(id = 1),
    analytics        INTEGER NOT NULL DEFAULT 0,
    crashReporting   INTEGER NOT NULL DEFAULT 0,
    consentVersion   INTEGER NOT NULL DEFAULT 0,
    consentTimestamp INTEGER,
    hasDecided       INTEGER NOT NULL DEFAULT 0
);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

select:
SELECT * FROM ConsentPreferencesEntity WHERE id = 1;

-- ─── Escritura ────────────────────────────────────────────────────────────────

insertOrReplace:
INSERT OR REPLACE INTO ConsentPreferencesEntity(
    id, analytics, crashReporting, consentVersion, consentTimestamp, hasDecided
) VALUES (1, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM ConsentPreferencesEntity;
