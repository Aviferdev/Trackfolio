CREATE TABLE AssetCategoryEntity (
    id        TEXT    NOT NULL PRIMARY KEY,
    name      TEXT    NOT NULL,
    icon      TEXT    NOT NULL DEFAULT '📦',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    archived  INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_asset_category_archived ON AssetCategoryEntity(archived);

-- ─── Lectura ──────────────────────────────────────────────────────────────────

selectAll:
SELECT * FROM AssetCategoryEntity
WHERE archived = 0
ORDER BY sortOrder ASC, name ASC;

selectAllIncludingArchived:
SELECT * FROM AssetCategoryEntity
ORDER BY archived ASC, sortOrder ASC, name ASC;

selectById:
SELECT * FROM AssetCategoryEntity WHERE id = :id;

countAll:
SELECT COUNT(*) FROM AssetCategoryEntity WHERE archived = 0;

-- ─── Escritura ────────────────────────────────────────────────────────────────

insert:
INSERT OR IGNORE INTO AssetCategoryEntity(id, name, icon, sortOrder, archived, createdAt)
VALUES (?, ?, ?, ?, 0, ?);

updateNameAndIcon:
UPDATE AssetCategoryEntity
SET name = :name, icon = :icon
WHERE id = :id;

updateSortOrder:
UPDATE AssetCategoryEntity
SET sortOrder = :sortOrder
WHERE id = :id;

archive:
UPDATE AssetCategoryEntity
SET archived = 1
WHERE id = :id;

unarchive:
UPDATE AssetCategoryEntity
SET archived = 0
WHERE id = :id;
