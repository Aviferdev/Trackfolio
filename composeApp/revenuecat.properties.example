# ───────────────────────────────────────────────
# Plantilla de configuración de RevenueCat
# ───────────────────────────────────────────────
# 1. Copia este archivo:
#       cp composeApp/revenuecat.properties.example composeApp/revenuecat.properties
#
# 2. Obtén tus claves en RevenueCat Dashboard:
#       https://app.revenuecat.com → Project Settings → API Keys
#
# 3. Completa los valores en revenuecat.properties:
#    - Las claves sandbox (test_*) solo funcionan en entornos de prueba.
#    - Las claves de producción (goog_* / appl_*) procesan pagos reales.
#    - Si una clave se deja vacía, esa plataforma/entorno no configurará
#      RevenueCat y la app mostrará "No hay productos disponibles".
#
# 4. Verifica que el archivo esté ignorado por Git:
#       git check-ignore composeApp/revenuecat.properties
# ───────────────────────────────────────────────

# ─── Android ──────────────────────────────────

# Sandbox (entorno dev/testing) — empieza con "test_"
REVENUECAT_ANDROID_SANDBOX=

# Producción (Google Play) — empieza con "goog_"
# ⚠️ NUNCA subir esta clave al repositorio
REVENUECAT_ANDROID_PROD=

# ─── iOS ─────────────────────────────────────

# Sandbox (entorno dev/testing) — empieza con "test_"
REVENUECAT_IOS_SANDBOX=

# Producción (App Store) — empieza con "appl_"
# ⚠️ NUNCA subir esta clave al repositorio
REVENUECAT_IOS_PROD=
